# SubOceanNet live-data credentials.
# Copy this file to `.env` in the project root and fill in your own values.
# NEVER commit the real `.env` file (it is already covered by .gitignore).
# These are only ever read by scripts/live_fetch/*.py in the isolated
# .venv-live environment - the main app process never sees them and no API
# response ever includes them.

# Copernicus Marine Service (https://data.marine.copernicus.eu) - free account
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# Copernicus Climate Data Store / CDS API (https://cds.climate.copernicus.eu)
# Free account. After logging in, your URL + personal access token are shown
# at https://cds.climate.copernicus.eu/how-to-api
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
